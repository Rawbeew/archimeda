# ── Required secrets (CI passes these from GitHub Secrets) ──────────────
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Solana RPC (Helius). Get a key at https://dashboard.helius.dev/
HELIUS_API_KEY=your_helius_key_here

# EVM RPC (Alchemy) for Ethereum/Base. Get a key at https://dashboard.alchemy.com/
ALCHEMY_API_KEY=your_alchemy_key_here

# ── Optional overrides ──────────────────────────────────────────────────
# CEX_EXCHANGE=binance            # okx default (binance geo-blocks some VPS)
# SCAN_INTERVAL_SEC=900
# PAPER_MODE=true                 # true = paper trading only, never live
# HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=<key>
